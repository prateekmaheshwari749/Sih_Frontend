# ==============================================================================
# OceanEmbed / OceanIntel Frontend Configuration
# ==============================================================================
# Backend base URL (required for production / Cloudflare Pages).
# Vite embeds this at build time. Set the same variable in Cloudflare Pages
# → Settings → Environment variables → Production, then rebuild.
#
# Development default (used when unset): http://127.0.0.1:8000
#
# Do NOT put secrets here. This value is exposed to the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Legacy alias (optional). Prefer VITE_API_BASE_URL.
# VITE_BACKEND_URL=http://127.0.0.1:8000
